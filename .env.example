# Sao chép tệp này thành .env rồi tự điền các khóa của bạn.
# Có thể dùng nhiều khóa được quản lý hợp lệ để dự phòng khi một khóa gặp lỗi.
# Định dạng đơn giản: các khóa phân cách bằng dấu phẩy.
GROQ_API_KEYS=PASTE_GROQ_KEY_1_HERE,PASTE_GROQ_KEY_2_HERE

# Hoặc xóa dấu # và dùng các biến đánh số thay cho GROQ_API_KEYS:
# GROQ_API_KEY_1=PASTE_GROQ_KEY_1_HERE
# GROQ_API_KEY_2=PASTE_GROQ_KEY_2_HERE
# GROQ_API_KEY_3=PASTE_GROQ_KEY_3_HERE

# Tương thích cấu hình cũ nếu chỉ dùng một khóa:
# GROQ_API_KEY=PASTE_YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile
DISCORD_WEBHOOK_URL=PASTE_YOUR_NEW_DISCORD_WEBHOOK_URL_HERE
PORT=3000
